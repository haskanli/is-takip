{
  "name": "is-takip",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "node server/dev.js",
    "dev:api": "node --env-file=.env --env-file-if-exists=.env.local server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server/index.js",
    "reminders": "node server/reminderJob.js",
    "db:backup": "node --env-file=.env --env-file-if-exists=.env.local scripts/backup-app-state.mjs",
    "db:migrate": "node --env-file=.env --env-file-if-exists=.env.local scripts/migrate-app-state.mjs",
    "db:verify": "node --env-file=.env --env-file-if-exists=.env.local scripts/verify-normalized.mjs",
    "auth:sync": "node --env-file=.env --env-file-if-exists=.env.local scripts/sync-auth-profiles.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
